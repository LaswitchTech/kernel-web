composer.phar
/vendor/

# Node — build toolchain deps (never commit)
node_modules/

# macOS
.DS_Store

# Environment — never commit secrets or local settings
.env
/config/local.php

# Runtime SQLite — web root (never here)
public/*.sqlite
public/*.sqlite-shm
public/*.sqlite-wal
public/*.sqlite-journal

# Runtime SQLite — storage dir
storage/*.sqlite
storage/*.sqlite-shm
storage/*.sqlite-wal
storage/*.sqlite-journal

# Runtime persistent data
data/*.db
data/*.db-shm
data/*.db-wal

# Extension staging (local test uploads)
storage/extension-staging/

# Install lock
storage/installed.lock

# Local test plugins (slug ending in -test)
lib/plugins/*-test*/

# Logs
storage/logs/*
!storage/logs/.gitkeep
