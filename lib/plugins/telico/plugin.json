{
    "name": "telico",
    "version": "0.1.0",
    "description": "Telico SMS transport — wraps the Telico SMS API for sending SMS messages.",
    "enabled": true,
    "permissions": [],
    "plugin_hooks": {
        "plugins.bootstrap": {
            "priority": 50,
            "callback": "Plugins\\Telico\\TelicoHooks::bootstrap"
        }
    },
    "routes": [
        ["POST", "/api/telico/test-sms", "Plugins\\Telico\\TelicoApiController@testSms"]
    ]
}
